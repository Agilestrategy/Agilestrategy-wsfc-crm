# Browser-safe keys (Supabase project → Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only, for scripts/import-mailchimp.mjs. Never commit, never put in Netlify build env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push (member app notifications). Public key is browser-safe; private key + service role go in Netlify function env only.
VITE_VAPID_PUBLIC_KEY=BO8U...
VAPID_PUBLIC_KEY=BO8U...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:president@wsfc.co.nz
